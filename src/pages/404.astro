---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found"
  description="This page could not be found. Explore Shemar Marks’s services, case studies, or contact page."
  noindex
>
  <section class="section wrap">
    <p class="eyebrow">404 / A MISSING CONNECTION</p>
    <h1>
      This path
      <br />
      <span class="muted">ends here.</span>
    </h1>
    <p style="margin-block:30px">
      The page may have moved. Let’s get you back to something useful.
    </p>
    <a class="button" href="/">
      Back to the homepage ↗
    </a>
    <a class="text-link" style="margin-left:25px" href="/services/">
      Explore services ↗
    </a>
  </section>
</Layout>
