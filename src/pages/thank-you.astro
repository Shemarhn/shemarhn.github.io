---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Inquiry Received"
  description="Your message has been received by Shemar Marks."
  noindex
>
  <section class="section wrap contact-success">
    <p class="eyebrow">MESSAGE RECEIVED</p>
    <h1>
      Thanks for
      <br />
      <span class="blue">reaching out.</span>
    </h1>
    <p style="margin-top:35px">
      Your inquiry has been saved. I’ll review it and get back to you personally. If there’s
      anything to add, email{' '}
      <a class="blue" href="mailto:hello@shemarmarks.com">
        hello@shemarmarks.com
      </a>
      .
    </p>
    <p class="small">
      No need to submit again if an acknowledgment has not arrived. Your message is saved.
    </p>
    <a href="/work/" class="text-link">
      Explore the engineering work ↗
    </a>
  </section>
</Layout>
