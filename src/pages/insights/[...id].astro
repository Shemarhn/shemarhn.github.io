---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { services, projects, site } from '../../data/site';
export async function getStaticPaths() {
  const posts = await getCollection(
    'insights',
    ({ data }) => data.status === 'published' && data.date <= new Date(),
  );
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const schema = {
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.excerpt,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated || d.date).toISOString(),
  author: { '@id': `${site.url}/#person` },
  publisher: { '@id': `${site.url}/#person` },
  mainEntityOfPage: d.canonical || `${site.url}/insights/${post.id}/`,
  image: new URL(d.hero, site.url).href,
};
const related = (
  await getCollection(
    'insights',
    ({ data }) => data.status === 'published' && data.date <= new Date(),
  )
)
  .filter((p) => p.id !== post.id)
  .slice(0, 2);
---

<Layout
  title={d.title}
  description={d.excerpt}
  article
  schema={schema}
  image={d.hero}
  canonicalUrl={d.canonical}
>
  <section class="page-hero wrap">
    <p class="eyebrow">
      INSIGHTS / {d.category} / {d.readTime} MIN READ
    </p>
    <h1 style="font-size:clamp(2.7rem,5.8vw,5.7rem)">{d.title}</h1>
    <div class="article-head">
      <p>
        <a class="blue" href="/about/">
          Shemar Marks
        </a>
        <br />
        <time datetime={d.date.toISOString()}>
          {d.date.toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
      </p>
      <p>{d.excerpt}</p>
    </div>
  </section>
  <section class="content-grid section wrap">
    <aside class="toc">
      <p class="eyebrow">IN THIS ARTICLE</p>
      <nav aria-label="Article table of contents">
        {headings
          .filter((h) => h.depth === 2)
          .map((h) => (
            <a href={`#${h.slug}`}>{h.text}</a>
          ))}
      </nav>
    </aside>
    <article class="prose">
      <div class="article-hero-art" role="img" aria-label="Shemar Marks infrastructure insights">
        <span>
          Notes from the
          <br />
          systems side.
        </span>
        <img src="/assets/sm-monogram.svg" alt="" width="120" height="120" />
      </div>
      <Content />
      <div class="share-links">
        <button data-copy-link>Copy article link ↗</button>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`${site.url}/insights/${post.id}/`)}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Share on LinkedIn ↗
        </a>
      </div>
      <div class="article-footer">
        <p class="eyebrow">CONNECTED TO THE WORK</p>
        <p>
          {d.relatedServices.map((slug) => {
            const s = services.find((s) => s.slug === slug);
            return (
              s && (
                <>
                  <a href={`/services/${s.slug}/`}>{s.name}</a>
                  <br />
                </>
              )
            );
          })}
        </p>
        <p>
          {d.relatedCases.map((slug) => {
            const p = projects.find((p) => p.slug === slug);
            return (
              p && (
                <>
                  <a href={`/work/${p.slug}/`}>Lab case study: {p.name}</a>
                  <br />
                </>
              )
            );
          })}
        </p>
        <h3>Keep reading.</h3>
        {related.map((p) => (
          <p>
            <a href={`/insights/${p.id}/`}>{p.data.title}</a>
          </p>
        ))}
        <a
          class="button"
          style="text-decoration:none;margin-top:20px"
          href={`/contact/?cta=Insight%20article&campaign=${encodeURIComponent(post.id)}`}
        >
          Discuss your project <Icon size={17} />
        </a>
      </div>
    </article>
  </section>
</Layout>
