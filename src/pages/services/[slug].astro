---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { serviceSearch } from '../../data/service-search';
import { serviceEngagements } from '../../data/service-engagements';
import { services, projects, site } from '../../data/site';
import { getCollection } from 'astro:content';
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service: s } = Astro.props;
const search = serviceSearch[s.slug];
const engagement = serviceEngagements[s.slug];
const connectedServices = engagement.related.map((slug) =>
  services.find((service) => service.slug === slug)!,
);
const insights = await getCollection(
  'insights',
  ({ data }) =>
    data.status === 'published' && data.date <= new Date() && data.relatedServices.includes(s.slug),
);
const project = projects.find((p) => p.slug === s.related)!;
const schema = {
  '@type': 'Service',
  '@id': `${site.url}/services/${s.slug}/#service`,
  name: s.name,
  description: s.summary,
  url: `${site.url}/services/${s.slug}/`,
  provider: { '@id': `${site.url}/#person` },
  serviceType: s.name,
  areaServed: ['United States', 'Canada', 'United Kingdom', 'Europe', 'Caribbean'],
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: `${site.url}/contact/`,
    availableLanguage: 'English',
  },
};
const faq = {
  '@type': 'FAQPage',
  '@id': `${site.url}/services/${s.slug}/#faq`,
  mainEntity: [
    { '@type': 'Question', name: s.faq[0], acceptedAnswer: { '@type': 'Answer', text: s.faq[1] } },
    {
      '@type': 'Question',
      name: engagement.question,
      acceptedAnswer: { '@type': 'Answer', text: engagement.answer },
    },
  ],
};
---

<Layout
  title={search.title}
  description={
    s.slug === 'cloud-infrastructure'
      ? 'AWS and Azure infrastructure consulting for small teams. Plan cloud deployments, migrations, networking, access, and recovery with a documented handover.'
      : s.summary
  }
  schema={[schema, faq]}
>
  <Breadcrumbs section="Services" href="/services/" current={s.name} />
  <PageHero
    label={`SERVICES / ${s.name}`}
    title={search.h1}
    description={s.intro}
    cta="Discuss this service"
    service={s.name}
  />
  <section class="content-grid section wrap">
    <aside>
      <p class="eyebrow">IN THIS ENGAGEMENT</p>
      <a href="#fit">When it helps</a>
      <a href="#deliverables">What you receive</a>
      <a href="#approach">How I work</a>
      <a href="#scope">Scope & boundaries</a>
      <a href="#evidence">Relevant evidence</a>
      <a href="#first-discussion">What to share first</a>
    </aside>
    <div class="prose">
      <h2>{s.short}</h2>
      <p>{search.context}</p>
      <h2 id="fit">When this is useful.</h2>
      <p>{s.fit}</p>
      <ul>
        {s.problems.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
      <h2 id="deliverables">What you receive.</h2>
      <ul class="deliverables">
        {s.deliverables.map((d) => (
          <li>
            <Icon name="check" size={17} />
            {d}
          </li>
        ))}
      </ul>
      <h2 id="approach">A clear way through.</h2>
      <ol>
        {s.approach.map((a) => (
          <li>{a}</li>
        ))}
      </ol>
      <h2 id="scope">Scope before implementation.</h2>
      <p>{s.scope}</p>
      <div class="scope-note">
        <p>
          Every engagement begins with deliverables, access requirements, acceptance checks, and
          responsibilities agreed in writing. Work outside that scope is discussed before it becomes
          a change.
        </p>
      </div>
      <h2 id="evidence">Engineering you can inspect.</h2>
      {s.slug === 'websites' ? (
        <p>
          This website is a working example of my website engineering: static service and article
          pages, a custom Cloudflare Worker, inquiry storage, and separate email delivery tasks.
          Inspect the{' '}
          <a
            href="https://github.com/Shemarhn/shemarhn.github.io"
            target="_blank"
            rel="noopener noreferrer"
          >
            website source and architecture documentation
          </a>{' '}
          to see the implementation. It is my own consulting site, not a client case study or
          evidence of a client’s sales results.
        </p>
      ) : (
        <p>
          {project.summary} The <a href={`/work/${project.slug}/`}>{project.name} case study</a>{' '}
          documents the implementation, checks, and limits of an executed synthetic lab.
        </p>
      )}
      {s.slug === 'infrastructure-documentation' && (
        <p>
          My <a href="/about/">professional background</a> also includes a paid enterprise
          documentation review. Client material remains private; the public lab runbooks show
          documentation you can inspect without implying that they are paid client work.
        </p>
      )}
      <details class="faq">
        <summary>{s.faq[0]}</summary>
        <p>{s.faq[1]}</p>
      </details>
      <details class="faq">
        <summary>{engagement.question}</summary>
        <p>{engagement.answer}</p>
      </details>
      {s.slug === 'cloud-infrastructure' && (
        <>
          <h2>AWS infrastructure help.</h2>
          <p>
            Scope EC2 application hosting, VPC and security-group configuration, IAM and Systems
            Manager access, S3 backup storage, and CloudWatch operational signals around the
            workload. The <a href="/work/northstar/">NORTHSTAR recovery lab</a> shows an executed
            AWS and Terraform example, including its validation and cleanup.
          </p>
          <h2>Azure infrastructure help.</h2>
          <p>
            Review virtual machines, virtual networks, access boundaries, and the migration path
            from the current host. Azure was my first cloud platform. Implementation starts with
            your existing configuration and the services required by your application; unfamiliar
            specialist services are identified before a scope is accepted.
          </p>
        </>
      )}
      {s.slug === 'proxmox-virtualization' && (
        <>
          <h2>Migration readiness before a cutover.</h2>
          <p>
            A readiness review should resolve guest compatibility, destination capacity, storage and
            network mappings, a representative pilot, and application acceptance checks. Use the{' '}
            <a href="/insights/proxmox-migration-readiness-checklist/">
              Proxmox migration readiness checklist
            </a>{' '}
            to prepare the decisions before a cutover is scheduled.
          </p>
          <p>
            A snapshot alone does not establish an independent recovery path. Identify which copies
            survive loss of the host, storage, or site, then test restoration of a representative
            workload. Read{' '}
            <a href="/insights/a-backup-is-not-a-recovery-plan/">
              why a backup is not a recovery plan
            </a>{' '}
            and the{' '}
            <a href="/services/backup-disaster-recovery/">backup and disaster recovery service</a>{' '}
            for the recovery scope.
          </p>
        </>
      )}
      {insights.length > 0 && (
        <>
          <h2>Practical reading before a project.</h2>
          <ul>
            {insights.map((post) => (
              <li>
                <a href={`/insights/${post.id}/`}>{post.data.title}</a> — {post.data.excerpt}
              </li>
            ))}
          </ul>
        </>
      )}
      <h2>Connected services.</h2>
      <p>
        {connectedServices.map((x, i) => (
          <>
            <a href={`/services/${x.slug}/`}>{x.name}</a>
            {i < connectedServices.length - 1 ? ' · ' : ''}
          </>
        ))}
      </p>
      <h2 id="first-discussion">A useful first discussion.</h2>
      <p>{engagement.intake}</p>
      <p>
        Send a short summary through the contact form. Keep passwords, access tokens, customer data,
        and private configuration out of the inquiry; any necessary access is arranged after the
        scope and permissions are agreed.
      </p>
      <p>
        Review <a href="/pricing/">engagements and pricing expectations</a>,{' '}
        <a href="/about/">my background</a>, and{' '}
        <a href="/insights/">practical infrastructure notes</a> before we discuss a scope. Remote
        work is available for US, Canadian, UK, European, and Caribbean teams, with access and
        working hours agreed in advance.
      </p>
    </div>
  </section>
  <section class="callout wrap">
    <div>
      <h2>Let’s define the right scope.</h2>
      <p>Tell me about the system and the outcome you need.</p>
    </div>
    <a
      class="button"
      href={`/contact/?service=${encodeURIComponent(s.name)}&cta=Service%20page&source=Website`}
    >
      Discuss a project <Icon size={18} />
    </a>
  </section>
</Layout>
