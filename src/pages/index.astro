---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Monogram from '../components/Monogram.astro';
import AmbientGrid from '../components/AmbientGrid.astro';
import TechnologyCarousel from '../components/TechnologyCarousel.astro';
import { services, projects } from '../data/site';
import { getCollection } from 'astro:content';
const posts = (
  await getCollection(
    'insights',
    ({ data }) => data.status === 'published' && data.date <= new Date(),
  )
)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<Layout
  title="Cloud Infrastructure, Linux & Automation Consultant"
  description="Independent cloud infrastructure, Linux, and automation consulting by Shemar Marks. Clear ownership, repeatable deployments, and tested recovery for remote teams."
>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-topline mono">
      <span>
        <span class="status-dot"></span> SHEMAR MARKS / INDEPENDENT CONSULTANT
      </span>
      <span class="hero-coordinate">JAMAICA / WORKING REMOTELY</span>
    </div>
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">CLOUD INFRASTRUCTURE · LINUX · AUTOMATION</p>
        <h1 id="hero-title">
          Infrastructure.
          <br />
          Built to <span class="hero-word">hold.</span>
        </h1>
        <p class="hero-lead">
          I build, improve, and automate the systems
          <br class="desktop-break" /> your business depends on.
        </p>
        <div class="hero-actions">
          <a class="button" href="/contact/?cta=Homepage%20hero">
            Discuss a project <Icon size={18} />
          </a>
          <a class="text-link" href="/work/">
            Explore my work <span aria-hidden="true">↘</span>
          </a>
        </div>
        <p class="hero-footnote">Clear ownership. Thoughtful engineering. A usable handover.</p>
      </div>
      <div class="hero-scene" data-sm-hero>
        <AmbientGrid id="hero-drafting" cross />
        <canvas class="ribbon-canvas" data-ribbon aria-hidden="true"></canvas>
        <div class="scene-orbit scene-orbit-one" aria-hidden="true"></div>
        <div class="scene-orbit scene-orbit-two" aria-hidden="true"></div>
        <div class="scene-floor" aria-hidden="true"></div>
        <div
          class="hero-logo-frame"
          data-logo-tilt
          role="img"
          aria-label="Shemar Marks faceted SM monogram"
        >
          <Monogram id="hero-sm" />
        </div>
        <span class="scene-label scene-label-top mono">
          <i></i>CLOUD
        </span>
        <span class="scene-label scene-label-left mono">
          <i></i>SYSTEMS
        </span>
        <span class="scene-label scene-label-right mono">
          <i></i>AUTOMATION
        </span>
        <div class="scene-caption">
          <span class="mono">SM / CONNECTED BY DESIGN</span>
          <button
            class="monogram-replay"
            data-logo-replay
            type="button"
            aria-label="Replay logo assembly"
          >
            <Icon name="recover" size={14} /> REPLAY
          </button>
        </div>
      </div>
    </div>
    <div class="hero-bottom">
      <div class="hero-stack-teaser">
        <span class="mono">ACROSS THE STACK</span>
        {['aws', 'azure', 'gcp', 'cloudflare', 'docker', 'terraform'].map((id) => (
          <img
            src={`/assets/technologies/${id}.svg`}
            width="25"
            height="25"
            alt={
              id === 'gcp'
                ? 'Google Cloud'
                : id === 'aws'
                  ? 'AWS'
                  : id === 'azure'
                    ? 'Azure'
                    : id === 'cloudflare'
                      ? 'Cloudflare'
                      : id === 'docker'
                        ? 'Docker'
                        : 'Terraform'
            }
          />
        ))}
      </div>
      <a href="#perspective" class="scroll-hint mono">
        SCROLL TO EXPLORE <Icon name="down" size={15} />
      </a>
    </div>
  </section>
  <section id="perspective" class="intro section wrap">
    <p class="eyebrow reveal">01 / THE WAY I THINK</p>
    <div>
      <h2 class="reveal">
        The real work starts
        <br />
        where the pieces <span class="muted">connect.</span>
      </h2>
      <div class="intro-body">
        <p class="reveal">
          An application needs more than a place to run. It needs a deployment you can repeat, a
          backup you can restore, and documentation someone can actually use.
        </p>
        <p class="reveal">
          I’m Shemar—an independent consultant working across cloud infrastructure, Linux, and
          automation. I take ownership of the details between “it works” and “we can operate it.”
        </p>
      </div>
      <a class="text-link" href="/about/">
        Meet the engineer <Icon size={16} />
      </a>
    </div>
  </section>
  <section class="services-home section wrap">
    <div class="section-heading reveal">
      <div>
        <p class="eyebrow">02 / HOW I CAN HELP</p>
        <h2>
          Built for what
          <br />
          comes <span class="muted">next.</span>
        </h2>
      </div>
      <p>
        From the first architecture decision to the recovery plan. Focused work, with the scope and
        acceptance checks agreed up front.
      </p>
    </div>
    <div class="service-list">
      {[services[0], services[1], services[2], services[3], services[4]].map((s, i) => (
        <a class="service-row reveal" href={`/services/${s.slug}/`}>
          <span class="mono service-index">0{i + 1}</span>
          <Icon name={s.icon} size={27} />
          <h3>{s.name}</h3>
          <p>{s.summary}</p>
          <span class="service-arrow">
            <Icon size={22} />
          </span>
        </a>
      ))}
    </div>
    <div class="section-end">
      <p class="muted">Also: documentation, ongoing care, agency partnerships, and websites.</p>
      <a class="text-link" href="/services/">
        Explore all services <Icon size={16} />
      </a>
    </div>
  </section>
  <section class="work-home section wrap" id="selected-work">
    <div class="section-heading reveal">
      <div>
        <p class="eyebrow">03 / SELECTED ENGINEERING</p>
        <h2>
          Show the work.
          <br />
          <span class="muted">Keep the evidence.</span>
        </h2>
      </div>
      <div>
        <p>
          Real implementation. Recorded checks. Honest limits. These are executed synthetic
          engagements, clearly labeled as lab work.
        </p>
        <a href="/work/" class="text-link">
          All case studies <Icon size={16} />
        </a>
      </div>
    </div>
    <div class="projects-grid">
      {projects.map((project, index) => (
        <div class="reveal">
          <ProjectCard project={project} index={index} />
        </div>
      ))}
    </div>
  </section>
  <TechnologyCarousel />
  <section class="method section wrap" data-nudge-trigger>
    <div>
      <p class="eyebrow reveal">05 / HOW WE GET THERE</p>
      <h2 class="reveal">
        No black box.
        <br />
        <span class="muted">No loose ends.</span>
      </h2>
      <a class="text-link" href="/pricing/">
        Engagements & pricing <Icon size={16} />
      </a>
    </div>
    <ol class="method-list">
      {[
        ['Understand', 'Map the workload, the constraints, and what success needs to look like.'],
        ['Build', 'Implement a focused solution, with changes you can inspect and understand.'],
        ['Verify', 'Test the agreed outcomes. Record the evidence and the limits.'],
        ['Hand over', 'Leave you with useful documentation and a clear path for ongoing care.'],
      ].map(([name, desc], i) => (
        <li class="reveal">
          <span class="mono">0{i + 1}</span>
          <div>
            <h3>{name}</h3>
            <p>{desc}</p>
          </div>
          <Icon name="plus" size={18} />
        </li>
      ))}
    </ol>
  </section>
  <section class="website-section wrap reveal">
    <p class="eyebrow">A GOOD WEBSITE IS A SYSTEM, TOO.</p>
    <h2>
      Yes, I build
      <br />
      <span class="blue">these too.</span>
    </h2>
    <div>
      <p>
        A considered front end. Reliable forms. Useful integrations. The same engineering care,
        starting at your business’s front door.
      </p>
      <button class="text-link" data-modal-open>
        Want a website like this? <Icon size={18} />
      </button>
    </div>
    <span class="website-bg" aria-hidden="true">
      &lt;/&gt;
    </span>
  </section>
  <section class="insights-home section wrap">
    <div class="section-heading reveal">
      <div>
        <p class="eyebrow">06 / NOTES FROM THE SYSTEMS SIDE</p>
        <h2>
          Practical <span class="muted">insights.</span>
        </h2>
      </div>
      <a class="text-link" href="/insights/">
        Read all insights <Icon size={16} />
      </a>
    </div>
    <div class="insights-list">
      {posts.map((post, i) => (
        <a class="insight-row reveal" href={`/insights/${post.id}/`}>
          <span class="mono insight-number">0{i + 1}</span>
          <div>
            <p class="eyebrow">
              {post.data.category} <span class="muted">/ {post.data.readTime} MIN READ</span>
            </p>
            <h3>{post.data.title}</h3>
          </div>
          <Icon size={23} />
        </a>
      ))}
    </div>
  </section>
</Layout>
