---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { pricing } from '../data/site';
---

<Layout
  title="Consulting Engagements & Pricing"
  description="Fixed-scope projects, custom infrastructure consulting, and monthly maintenance with Shemar Marks. Agree deliverables, acceptance criteria, and pricing before work begins."
>
  <PageHero
    label="ENGAGEMENTS & PRICING"
    title="Clear scope."
    accent="Considered investment."
    description="The right price follows the workload, the risk, and the deliverables. I quote against a written scope so you can make a useful decision before the work starts."
  />
  <section class="section wrap">
    <div class="pricing-grid">
      {pricing.map((p) => (
        <article class="price-item">
          <p class="eyebrow">{p.model}</p>
          <h2>{p.name}</h2>
          <p>{p.detail}</p>
          <p class="price-model">Quoted to your scope</p>
          <p class="small">Deliverables and acceptance checks agreed first.</p>
          <a
            class="text-link"
            href={`/contact/?service=${encodeURIComponent(p.name)}&cta=Pricing%20page`}
          >
            Discuss an engagement <Icon size={16} />
          </a>
          <br />
          <a class="small muted" href={`/services/${p.service}/`}>
            What’s included ↗
          </a>
        </article>
      ))}
    </div>
    <div class="scope-note">
      <p>
        No speculative starting prices or fixed response guarantees. Your proposal will specify the
        fee, currency, payment stages, included revisions, assumptions, and any third-party costs.
        Website content and integrations, infrastructure access, and support hours are scoped
        explicitly.
      </p>
    </div>
    <div class="prose" style="margin-top:40px">
      <h2>What helps me quote the work.</h2>
      <p>
        Describe what is running, what needs to change, the intended deadline, and any acceptable
        downtime. Mention who will review and accept the work. An approximate budget is useful if
        you have one; a technical specification is not required for the first discussion.
      </p>
      <p>
        If the environment is too uncertain for an implementation quote, we can first agree a
        defined assessment with findings and next steps. Send a sanitized summary through{' '}
        <a href="/contact/?cta=Pricing%20scope">the project inquiry form</a> to start the
        discussion.
      </p>
    </div>
  </section>
</Layout>
