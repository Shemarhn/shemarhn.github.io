---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Monogram from '../components/Monogram.astro';
import '../styles/experience.css';
import { site } from '../data/site';
interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  article?: boolean;
  image?: string;
  canonicalUrl?: string;
}
const {
  title,
  description,
  schema,
  noindex = false,
  article = false,
  image = '/assets/social-preview.png',
  canonicalUrl,
} = Astro.props;
const path = Astro.url.pathname;
const canonical = canonicalUrl || new URL(path, site.url).href;
const person = {
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  url: `${site.url}/about/`,
  jobTitle: 'Independent Consultant',
  sameAs: Object.values(site.socials),
  image: `${site.url}/assets/shemar-marks.webp`,
  knowsAbout: [
    'Cloud Infrastructure',
    'AWS',
    'Microsoft Azure',
    'Linux',
    'Proxmox',
    'Terraform',
    'Automation',
  ],
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'BSc Computer Science',
      credentialCategory: 'degree',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'AWS Certified Cloud Practitioner',
      credentialCategory: 'certification',
    },
  ],
};
const graph = [
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    name: site.name,
    url: site.url,
    publisher: { '@id': `${site.url}/#person` },
  },
  person,
  {
    '@type': 'Organization',
    '@id': `${site.url}/#service`,
    name: 'Shemar Marks — Independent Consulting',
    url: site.url,
    email: site.email,
    founder: { '@id': `${site.url}/#person` },
    logo: `${site.url}/assets/sm-monogram.svg`,
    sameAs: Object.values(site.socials),
    description: site.descriptor,
    areaServed: ['United States', 'Canada', 'United Kingdom', 'Europe', 'Caribbean'],
  },
  ...(path === '/'
    ? []
    : [
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
            ...(path.match(/^\/(services|work|insights)\/[^/]+\//)
              ? [
                  {
                    '@type': 'ListItem',
                    position: 2,
                    name:
                      path.split('/')[1] === 'services'
                        ? 'Services'
                        : path.split('/')[1] === 'work'
                          ? 'Work'
                          : 'Insights',
                    item: `${site.url}/${path.split('/')[1]}/`,
                  },
                ]
              : []),
            {
              '@type': 'ListItem',
              position: path.match(/^\/(services|work|insights)\/[^/]+\//) ? 3 : 2,
              name: title.split(' | ')[0],
              item: canonical,
            },
          ],
        },
      ]),
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];
const nav = [
  ['Services', '/services/'],
  ['Work', '/work/'],
  ['Insights', '/insights/'],
  ['About', '/about/'],
];
const analytics = import.meta.env.PUBLIC_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <script is:inline src="/motion-preference.js"></script>
    <title>{title} | Shemar Marks</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080f1c" />
    {path === '/' && <meta name="msvalidate.01" content="4FA60B7F501C47147288A0C0875C6CD8" />}
    <meta
      name="robots"
      content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/sm-monogram.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/favicon.png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Shemar Marks — Insights"
      href="/rss.xml"
    />
    <meta property="og:title" content={`${title} | Shemar Marks`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Shemar Marks" />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Shemar Marks — Cloud Infrastructure, Linux, Automation"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Shemarhn" />
    <meta name="twitter:title" content={`${title} | Shemar Marks`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site.url).href} />
    <meta
      name="twitter:image:alt"
      content="Shemar Marks — Cloud Infrastructure, Linux, Automation"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(
        /</g,
        '\\u003c',
      )}
    />
    {analytics && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analytics })}
      ></script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header wrap">
      <a href="/" class="brand" aria-label="Shemar Marks home">
        <span class="brand-symbol">
          <Monogram id="header-sm" />
        </span>
        <span>
          shemarmarks<span class="blue">.com</span>
          <small>INDEPENDENT CONSULTANT</small>
        </span>
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="navigation">
        Menu <span aria-hidden="true">+</span>
      </button>
      <nav id="navigation" aria-label="Main navigation">
        {nav.map(([label, href]) => (
          <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
            {label}
          </a>
        ))}
        <a class="nav-cta" href="/contact/?cta=Navigation">
          Let’s talk <Icon size={15} />
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="footer wrap">
      <div class="footer-top">
        <p class="eyebrow">YOUR NEXT MOVE</p>
        <a class="footer-invite" href="/contact/?cta=Footer">
          Let’s build something
          <br />
          <span>that holds up.</span>
          <Icon size={62} />
        </a>
        <a class="text-link" href="mailto:hello@shemarmarks.com">
          hello@shemarmarks.com <Icon size={15} />
        </a>
      </div>
      <div class="footer-grid">
        <div>
          <a class="footer-name" href="/">
            Shemar Marks<span class="blue">.</span>
          </a>
          <p>Cloud Infrastructure · Linux · Automation</p>
          <p>
            Based in Jamaica. Remote consulting for US, Canadian, UK, European, and Caribbean teams.
          </p>
        </div>
        <div>
          <a href="/services/">Services</a>
          <a href="/work/">Case studies</a>
          <a href="/pricing/">Engagements & pricing</a>
        </div>
        <div>
          <a href="/references/">References</a>
          <a href="/insights/">Insights</a>
          <a href="/about/">About Shemar</a>
        </div>
        <div>
          {Object.entries(site.socials).map(([name, url]) => (
            <a href={url} target="_blank" rel="noopener noreferrer">
              {name} ↗
            </a>
          ))}
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getUTCFullYear()} Shemar Marks</span>
        <span>Considered systems. Clear ownership.</span>
        <a href="/privacy/">Privacy</a>
        <a href="/rss.xml">RSS ↗</a>
        <button data-motion-toggle aria-pressed="false">
          Pause motion
        </button>
      </div>
    </footer>
    <div class="website-nudge" hidden>
      <button class="nudge-open" data-modal-open>
        <span class="nudge-dot"></span>I build websites, too. <Icon size={16} />
      </button>
      <button class="nudge-close" aria-label="Dismiss website invitation">
        ×
      </button>
    </div>
    <dialog id="website-dialog" aria-labelledby="website-dialog-title">
      <button data-modal-close class="dialog-close" aria-label="Close website invitation">
        ×
      </button>
      <p class="eyebrow">THE WEBSITE YOU’RE ON? I BUILT IT.</p>
      <h2 id="website-dialog-title">
        Want something
        <br />
        <span class="blue">like this?</span>
      </h2>
      <p>
        I design and build modern business websites, including hosting, forms, booking,
        integrations, and automation.
      </p>
      <a
        class="button"
        href="/contact/?service=Website%20Development&source=Website&campaign=Want%20a%20Website%20Like%20This%20CTA&cta=Website%20panel"
      >
        Tell me about your website <Icon size={18} />
      </a>
      <a class="text-link" href="mailto:hello@shemarmarks.com?subject=Website%20project">
        Email me directly <Icon size={16} />
      </a>
    </dialog>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
